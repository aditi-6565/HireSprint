# ==============================================================================
# HIRESPRINT — AI-Powered Group Discussion and LMS Environment Configuration
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=4000

# Client Application URL (CORS & Socket.IO Allowed Origin)
CLIENT_URL=http://localhost:5173

# Database Connection
# MERN standard: MongoDB URI
# If MongoDB is running locally, use mongodb://127.0.0.1:27017/hiresprint
# For cloud deployments, use your MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/hiresprint?retryWrites=true&w=majority
# Note: In development or test, if no local/remote MongoDB is running,
# HireSprint will safely launch an embedded MongoDB memory instance automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/hiresprint

# Authentication & Security
JWT_SECRET=hiresprint-secure-development-jwt-secret-replace-in-production
JWT_EXPIRES_IN=24h
COOKIE_SECRET=hiresprint-cookie-secret-replace-in-production

# AI Provider Configuration (Groq API)
# Get your free/pro API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# WebRTC & STUN/TURN Server Configuration
# Multiple STUN/TURN servers can be configured for restrictive network traversal.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Live Meeting & AI Moderation Settings
MODERATOR_COOLDOWN_SECONDS=25
TRANSCRIPT_BUFFER_WINDOW_SECONDS=10
AUTO_EVALUATION_ON_COMPLETE=true

# Speech-to-Text & Text-to-Speech (Optional external providers)
# Default STT uses browser native Web Speech API in Chrome/Edge.
# Default TTS for spoken moderator mode uses browser SpeechSynthesis or configurable provider.
SPEECH_PROVIDER=browser
TTS_PROVIDER=browser
